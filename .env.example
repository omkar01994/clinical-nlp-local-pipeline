# --- Stage 1: ClinicalBERT (Hugging Face, runs locally via transformers) ---
CLINICAL_BERT_MODEL=emilyalsentzer/Bio_ClinicalBERT
# Set to a local folder to run fully offline after scripts/download_models.py
HF_HOME=./models/hf
DEVICE=cpu                      # cpu | cuda
TOP_K_PASSAGES=3
TOP_K_SENTENCES=5
MIN_LEXICAL_SCORE=1.0           # BM25 gate: below this we say "no reliable info"
HYBRID_ALPHA=0.3                # weight of ClinicalBERT vs BM25 when ranking (0..1)
PASSAGE_KEEP_RATIO=0.7          # keep extra topics only if score >= ratio * best topic

# --- Stage 2: Tone / empathy LLM (Ollama, local) ---
OLLAMA_HOST=http://localhost:11434
TONE_LLM_MODEL=llama3.2:3b
DEFAULT_TONE=empathetic         # empathetic | reassuring | professional | simple
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120

# --- Paths ---
KNOWLEDGE_BASE_DIR=./data/knowledge_base
INDEX_DIR=./data/index
